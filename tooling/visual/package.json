    "test:sections": "playwright test --config playwright.sections.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@solar/config": "workspace:*",
    "@types/node": "20.19.37",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
