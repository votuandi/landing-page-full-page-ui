{
  "name": "@solar/visual",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/matrix-colors.test.js matrix-report.test.mjs matrix-baseline.test.mjs preset-tools.test.mjs",
    "matrix:test": "playwright test -c playwright.matrix.config.ts",
    "matrix:update": "playwright test -c playwright.matrix.config.ts --update-snapshots",
    "matrix:report": "node matrix-report.mjs",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "test:fonts": "playwright test --config playwright.fonts.config.ts",
    "test:sections": "playwright test --config playwright.sections.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@solar/config": "workspace:*",
    "@types/node": "20.19.37",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
