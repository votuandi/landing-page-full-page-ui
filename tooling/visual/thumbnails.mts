import { chromium } from "@playwright/test";
import sharp from "sharp";
import { mkdir, readdir, writeFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { sectionRegistry } from "@solar/sections";
import { themes } from "@solar/themes";
import { matrixCaptureCss } from "./matrix-capture.js";

const root = new URL("../../apps/admin/public/section-thumbs/", import.meta.url);
const base = process.env.THUMBNAILS_BASE_URL ?? "http://localhost:3000";
const selectedTypes = process.env.THUMBNAILS_TYPES?.split(",") ?? Object.keys(sectionRegistry.types);
const selectedThemes = process.env.THUMBNAILS_THEMES?.split(",") ?? themes.map(t => t.meta.id);
const browser = await chromium.launch({ headless: true });
try {
  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: "reduce" });
  for (const type of selectedTypes) {
    if (!sectionRegistry.getType(type)) throw new Error(`Unknown type: ${type}`);
    const response = await page.goto(`${base}/lab/sections/${type}?themes=${selectedThemes.join(",")}`, { waitUntil: "networkidle", timeout: 120000 });
    if (!response?.ok()) throw new Error(`Lab failed: ${response?.status()} ${type}`);
    // Stack themes at full desktop width rather than the matrix's side-by-side columns.
    await page.addStyleTag({ content: `${matrixCaptureCss} main > .flex { display: block !important; } [data-lab-theme] { width: 100% !important; } [data-lab-cell] { max-height: 900px !important; overflow: hidden !important; }` });
    await page.evaluate(() => document.fonts.ready);
    for (const theme of selectedThemes) {
      if (!themes.some(t => t.meta.id === theme)) throw new Error(`Unknown theme: ${theme}`);
      await mkdir(new URL(`${theme}/`, root), { recursive: true });
      for (const variant of sectionRegistry.variantsOf(type) ?? []) {
        const cell = page.locator(`[data-lab-cell="${variant}--${theme}"]`);
        await cell.scrollIntoViewIfNeeded();
        const background = await cell.evaluate(el => getComputedStyle(el).backgroundColor);
        const png = await cell.screenshot({ animations: "disabled" });
        await sharp(png).resize(320, 200, { fit: "contain", position: "top", background }).webp({ quality: 60 }).toFile(fileURLToPath(new URL(`${theme}/${type}--${variant}.webp`, root)));
      }
      console.log(`Captured ${type}/${theme}`);
    }
  }
} finally { await browser.close(); }

// Publish only files that exist; interrupted runs keep the previous manifest and can be resumed.
const manifest: Record<string, string[]> = {};
for (const theme of themes) {
  const files = await readdir(new URL(`${theme.meta.id}/`, root)).catch(() => [] as string[]);
  manifest[theme.meta.id] = files.filter(file => file.endsWith(".webp")).map(file => file.slice(0, -5)).sort();
}
await writeFile(new URL("../../packages/cms-ui/src/sections/thumbnails.generated.ts", import.meta.url),
  `// Generated by pnpm --filter @solar/visual thumbnails. Do not edit.\nexport const sectionThumbnails: Readonly<Record<string, readonly string[]>> = ${JSON.stringify(manifest, null, 2)};\n`);
