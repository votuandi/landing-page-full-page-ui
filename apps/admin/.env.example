DATABASE_URL=postgresql://app_runtime:password@127.0.0.1:5432/solar
APP_ENCRYPTION_KEY=
PREVIEW_SECRET=
PLATFORM_DOMAIN=solar.localhost
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Use a shared Redis counter when running multiple instances.
REDIS_URL=redis://127.0.0.1:6379

# Media: base riêng thiếu/rỗng dùng MEDIA_PUBLIC_BASE; đặt đủ driver đang dùng.
MEDIA_PUBLIC_BASE=
MEDIA_PUBLIC_BASE_LOCAL=
MEDIA_PUBLIC_BASE_S3=
# Worker/CLI dùng cùng env: đặt thư mục JSON backup còn giữ, ở ngoài public.
MEDIA_BACKUP_DIR=

# Runtime package dùng chung; app admin chỉ mở pool DATABASE_URL.
PLATFORM_DATABASE_URL=
# Cổng web khi tạo link preview ở môi trường local.
TENANT_PUBLIC_PORT=
# Storage: local hoặc s3; Cloudflare R2 dùng driver s3 và S3_ENDPOINT.
STORAGE_DRIVER=
STORAGE_LOCAL_ROOT=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# E11-S02: kênh nhận lead (optional; APP_ENCRYPTION_KEY dùng chung với worker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
RESEND_API_KEY=
LEAD_EMAIL_FROM=
