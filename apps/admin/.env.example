DATABASE_URL=postgresql://app_runtime:password@127.0.0.1:5432/solar
PLATFORM_DOMAIN=solar.localhost
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Use a shared Redis counter when running multiple instances.
REDIS_URL=redis://127.0.0.1:6379

# Media: base riêng thiếu/rỗng dùng MEDIA_PUBLIC_BASE; đặt đủ driver đang dùng.
MEDIA_PUBLIC_BASE=
MEDIA_PUBLIC_BASE_LOCAL=
MEDIA_PUBLIC_BASE_S3=
# Worker/CLI dùng cùng env: đặt thư mục JSON backup còn giữ, ở ngoài public.
MEDIA_BACKUP_DIR=
