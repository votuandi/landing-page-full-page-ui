# ---- Website ----
MULTI_TENANT=0
# Bắt buộc khi MULTI_TENANT=1, role app_runtime.
DATABASE_URL=
# Tùy chọn đến khi sử dụng bí mật tích hợp; base64 32 byte, khóa mới đầu danh sách.
APP_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=https://template-15.minwysoft.com
# Thanh "website mẫu" + bảng thử màu (đặt false khi giao cho khách)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_TEMPLATE_CTA_URL=/lien-he
NEXT_PUBLIC_PRICING_URL=/lien-he
# installer = chỉ lắp đặt (ẩn catalog, menu Thiết bị, giỏ báo giá); installer_distributor = có catalog
NEXT_PUBLIC_SITE_MODE=installer_distributor
# false = tắt trang /san-pham, dải sản phẩm và giỏ yêu cầu báo giá (kể cả khi là nhà phân phối)
NEXT_PUBLIC_CATALOG_ENABLED=true

# ---- Gửi lead (form dự toán, giỏ báo giá, popup, đại lý, liên hệ) — bỏ trống tất cả = chế độ demo ----
# Chọn adapter cụ thể (mặc định: mọi adapter đã đủ biến): webhook,google-sheets,telegram
LEAD_ADAPTERS=
# Webhook chung (Zapier, Make, n8n, CRM…)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Google Sheet qua Apps Script (scripts/lead-google-apps-script.gs)
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SECRET=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEO multi-tenant (E5-S08): subdomain nền tảng/preview không index, phân tách dấu phẩy
PLATFORM_DOMAINS=

# Cache invalidation (E5-S05): cùng secret ngẫu nhiên trên web và worker, không công khai.
REVALIDATE_SECRET=
# Cache dữ liệu + Next "use cache" dùng chung; bỏ trống = bộ nhớ (dev). Redis trong mạng private.
REDIS_URL=
# Worker: có Redis chung → một URL bất kỳ; không có Redis → liệt kê từng tiến trình web.
# Ví dụ http://web-1:3000/api/revalidate,http://web-2:3000/api/revalidate
WEB_REVALIDATE_URLS=

# Cloudflare Turnstile cho form lead tenant (E11-S01) — đặt cả hai để bật; trống = tắt
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Preview (E5-S07): <slug>.preview.<PLATFORM_DOMAIN>, secret ngẫu nhiên ít nhất 32 byte.
PLATFORM_DOMAIN=
PREVIEW_SECRET=
# Hậu tố host không index (preview luôn noindex ngay tại proxy).
NOINDEX_DOMAINS=

# Media: base riêng thiếu/rỗng dùng MEDIA_PUBLIC_BASE; đặt đủ driver đang dùng.
MEDIA_PUBLIC_BASE=
MEDIA_PUBLIC_BASE_LOCAL=
MEDIA_PUBLIC_BASE_S3=
# Worker/CLI dùng cùng env: đặt thư mục JSON backup còn giữ, ở ngoài public.
MEDIA_BACKUP_DIR=
