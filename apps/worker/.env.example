PLATFORM_DATABASE_URL=postgresql://app_platform:password@127.0.0.1:5432/solar
# Base64 32 byte; khi xoay khóa: mới,cũ. Sinh bằng openssl rand -base64 32.
APP_ENCRYPTION_KEY=
REDIS_URL=
REVALIDATE_SECRET=
WEB_REVALIDATE_URLS=
MEDIA_PUBLIC_BASE=
MEDIA_PUBLIC_BASE_LOCAL=
MEDIA_PUBLIC_BASE_S3=
MEDIA_BACKUP_DIR=

# Runtime package dùng chung; worker chỉ mở pool PLATFORM_DATABASE_URL.
DATABASE_URL=
# Storage: local hoặc s3; Cloudflare R2 dùng driver s3 và S3_ENDPOINT.
STORAGE_DRIVER=
STORAGE_LOCAL_ROOT=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Tên executable hoặc đường dẫn, bỏ trống dùng ffmpeg/ffprobe trong PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Cờ kiểm ffmpeg cho test/CI: 0 hoặc 1, không ép cài binary khi startup.
MEDIA_REQUIRE_FFMPEG=
