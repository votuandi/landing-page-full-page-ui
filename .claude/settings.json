{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": { "source": "github", "repo": "openai/codex-plugin-cc" }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "permissions": {
    "allow": [
      "Bash(yarn typecheck)",
      "Bash(yarn lint)",
      "Bash(yarn test)",
      "Bash(yarn build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm turbo run *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(codex exec *)",
      "Bash(codex review *)",
      "Bash(node scripts/agents/story.mjs *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git ls-remote *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr *)",
      "mcp__claude_ai_github__get_me",
      "mcp__claude_ai_github__list_pull_requests",
      "mcp__claude_ai_github__pull_request_read",
      "mcp__claude_ai_github__create_pull_request",
      "mcp__claude_ai_github__pull_request_review_write",
      "mcp__claude_ai_github__add_issue_comment"
    ]
  }
}
