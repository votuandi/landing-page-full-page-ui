{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "packages/config/package.json",
    "packages/config/tsconfig.base.json",
    "packages/config/eslint.config.mjs",
    "packages/tokens/src/tailwind-preset.ts",
    "packages/tokens/src/color-keys.ts",
    "tooling/eslint-plugin/src/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "LAB_ENABLED",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SITE_MODE",
        "NEXT_PUBLIC_CATALOG_ENABLED",
        "NEXT_PUBLIC_DEMO_MODE",
        "NEXT_PUBLIC_TEMPLATE_CTA_URL",
        "NEXT_PUBLIC_PRICING_URL"
      ],
      "passThroughEnv": [
        "LEAD_ADAPTERS",
        "LEAD_WEBHOOK_URL",
        "LEAD_WEBHOOK_TOKEN",
        "GOOGLE_SHEETS_WEBAPP_URL",
        "GOOGLE_SHEETS_SECRET",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_CHAT_ID"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["NEXT_PUBLIC_*", "LEAD_*", "GOOGLE_SHEETS_*", "TELEGRAM_*", "DATABASE_URL", "REDIS_URL", "MULTI_TENANT"]
    },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": ["*.tsbuildinfo"] },
    "test": { "dependsOn": ["^build"], "outputs": [".test-dist/**"], "passThroughEnv": ["DATABASE_URL"] },
    "@solar/db#build": { "dependsOn": ["^build"], "outputs": ["generated/**"] },
    "@solar/db#typecheck": { "dependsOn": ["^typecheck", "build"], "outputs": ["generated/**", "*.tsbuildinfo"] },
    "@solar/db#test": { "dependsOn": ["^build", "build"], "outputs": [], "cache": false, "passThroughEnv": ["DATABASE_URL", "PLATFORM_DATABASE_URL", "TEST_OWNER_DATABASE_URL", "MIGRATION_DATABASE_URL", "SEED_PASSWORD", "RLS_REQUIRED"] },
    "web#test": { "dependsOn": ["^build"], "outputs": [".test-dist/**"], "cache": false, "passThroughEnv": ["DATABASE_URL", "PLATFORM_DATABASE_URL", "REDIS_URL"] },
    "@solar/eslint-plugin#test": { "dependsOn": ["^build"], "outputs": [] },
    "@solar/themes#test": { "dependsOn": ["^build"], "outputs": [] },
    "@solar/presets#test": { "dependsOn": ["^build"], "outputs": [] },
    "lint:tokens": { "outputs": [] },
    "//#lint:root": { "dependsOn": ["@solar/config#lint"], "outputs": [] }
  }
}
