{
  "name": "landing-page-full-page-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter web start",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "visual:test": "turbo run build --filter=web && pnpm --filter @solar/visual visual:test",
    "visual:update": "turbo run build --filter=web && pnpm --filter @solar/visual visual:update"
  },
  "devDependencies": {
    "@solar/config": "workspace:*",
    "eslint": "9.39.5",
    "turbo": "2.11.7"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.9"
  }
}
