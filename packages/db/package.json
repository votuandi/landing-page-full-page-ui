{
  "name": "@solar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts", "./collections": "./src/collections.ts", "./site-profile": "./src/siteProfile.ts" },
  "scripts": {
    "tenant:export": "tsx scripts/tenant-export.ts",
    "tenant:restore": "tsx scripts/tenant-restore.ts",
    "import:site-config": "tsx scripts/import-site-config.ts",
    "build": "prisma generate",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "sections:migrate": "tsx scripts/sections-migrate.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "db:erd": "node scripts/erd.mjs",
    "plans:sync": "tsx scripts/plans-sync.ts"
  },
  "dependencies": {
    "zod": "4.6.5",
    "@solar/cache": "workspace:*",
    "@solar/core": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1",
    "@solar/sections": "workspace:*",
    "@solar/presets": "workspace:*",
    "@solar/plans": "workspace:*",
    "@solar/storage": "workspace:*"
  },
  "devDependencies": {
    "@solar/config": "workspace:*",
    "@types/node": "20.19.37",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
