{
  "name": "@solar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "sections:migrate": "tsx scripts/sections-migrate.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "db:erd": "node scripts/erd.mjs",
    "plans:sync": "tsx scripts/plans-sync.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1",
    "@solar/sections": "workspace:*",
    "@solar/plans": "workspace:*"
  },
  "devDependencies": {
    "@solar/config": "workspace:*",
    "@solar/presets": "workspace:*",
    "@types/node": "20.19.37",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
