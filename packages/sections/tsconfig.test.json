{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": { "@solar/core": ["../core/src/index.ts"], "@solar/ui": ["../ui/src/index.ts"] },
    "jsx": "react-jsx",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-dist",
    "rootDir": ".."
  },
  "exclude": ["node_modules", ".test-dist", "src/__tests__/*.typecheck.ts"]
}
