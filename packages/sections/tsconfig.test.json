{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-dist",
    "rootDir": "src"
  },
  "exclude": ["node_modules", ".test-dist", "src/__tests__/*.typecheck.ts"]
}
