# ---- Website ----
NEXT_PUBLIC_SITE_URL=https://template-15.minwysoft.com
# Thanh "website mẫu" + bảng thử màu (đặt false khi giao cho khách)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_TEMPLATE_CTA_URL=/lien-he
NEXT_PUBLIC_PRICING_URL=/lien-he
# installer = chỉ lắp đặt (ẩn catalog, menu Thiết bị, giỏ báo giá); installer_distributor = có catalog
NEXT_PUBLIC_SITE_MODE=installer_distributor
# false = tắt trang /san-pham, dải sản phẩm và giỏ yêu cầu báo giá (kể cả khi là nhà phân phối)
NEXT_PUBLIC_CATALOG_ENABLED=true

# ---- Gửi lead (form dự toán, giỏ báo giá, popup, đại lý, liên hệ) — bỏ trống tất cả = chế độ demo ----
# Chọn adapter cụ thể (mặc định: mọi adapter đã đủ biến): webhook,google-sheets,telegram
LEAD_ADAPTERS=
# Webhook chung (Zapier, Make, n8n, CRM…)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Google Sheet qua Apps Script (scripts/lead-google-apps-script.gs)
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SECRET=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
